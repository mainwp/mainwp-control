{
  "name": "@mainwp/control",
  "version": "1.1.0",
  "description": "Command-line interface for scripting and automating MainWP Dashboard operations",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mainwpcontrol": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "scripts/completions",
    "oclif.manifest.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run clean && npm run build && oclif manifest",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:acceptance": "tsx tests/acceptance/run.ts",
    "test:acceptance:fast": "npm run build && tsx tests/acceptance/run.ts --mode source",
    "test:acceptance:fixture": "tsx tests/acceptance/run.ts --target fixture",
    "test:acceptance:writes": "tsx tests/acceptance/run.ts --writes",
    "test:acceptance:agent": "tsx tests/acceptance/agent-run.ts",
    "test:acceptance:human": "npm run test:acceptance:fixture && npm run test:acceptance:writes && npm run test:acceptance:agent",
    "test:process": "npm run build && vitest run --config vitest.process.config.ts",
    "test:live": "npm run build && MAINWP_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "test:all": "npm run test && npm run test:process",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack": "oclif pack tarballs",
    "pack:macos": "oclif pack macos",
    "pack:win": "oclif pack win",
    "pack:deb": "oclif pack deb"
  },
  "oclif": {
    "bin": "mainwpcontrol",
    "dirname": "mainwpcontrol",
    "commands": "./dist/commands",
    "default": "chat",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "hooks": {
      "command_not_found": "./dist/hooks/command-not-found.js"
    },
    "topicSeparator": " ",
    "macos": {
      "identifier": "com.mainwp.mainwpcontrol"
    },
    "update": {
      "s3": {
        "bucket": "mainwpcontrol-releases"
      }
    }
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "mainwp",
    "wordpress",
    "cli",
    "automation",
    "ci-cd",
    "devops",
    "scripting",
    "mainwp-control"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mainwp/mainwp-control",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainwp/mainwp-control.git"
  },
  "bugs": {
    "url": "https://github.com/mainwp/mainwp-control/issues"
  },
  "dependencies": {
    "@oclif/core": "^4.11.14",
    "@oclif/plugin-autocomplete": "^3.2.53",
    "@oclif/plugin-help": "^6.2.53",
    "ajv": "^8.18.0",
    "undici": "^7.28.0"
  },
  "optionalDependencies": {
    "keytar": "~7.9.0"
  },
  "overrides": {
    "filelist": {
      "minimatch": "^10.2.5"
    }
  },
  "devDependencies": {
    "@oclif/test": "^4.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "oclif": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
